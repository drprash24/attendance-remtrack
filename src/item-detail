import { useNavigate, useParams } from 'react-router-dom'
import { useLiveQuery } from 'dexie-react-hooks'
import { db, STATUS } from '../lib/db.js'

const statusLabel = {
  [STATUS.ON_TIME]: 'On time',
  [STATUS.LATE]: 'Late',
  [STATUS.ABSENT]: 'Absent',
  [STATUS.PENDING]: 'Pending'
}
const statusColor = {
  [STATUS.ON_TIME]: 'text-present',
  [STATUS.LATE]: 'text-late',
  [STATUS.ABSENT]: 'text-absent',
  [STATUS.PENDING]: 'text-muted'
}

export default function ItemDetail() {
  const { id } = useParams()
  const itemId = Number(id)
  const navigate = useNavigate()

  const item = useLiveQuery(() => db.items.get(itemId), [itemId])
  const records = useLiveQuery(
    () => db.records.where('itemId').equals(itemId).reverse().sortBy('date'),
    [itemId]
  )

  async function handleDelete() {
    await db.transaction('rw', db.items, db.records, db.reminders, async () => {
      await db.items.delete(itemId)
      await db.records.where('itemId').equals(itemId).delete()
      await db.reminders.where('itemId').equals(itemId).delete()
    })
    navigate('/')
  }

  if (!item) return null

  return (
    <div className="max-w-md mx-auto px-4 pb-24">
      <header className="pt-8 pb-6 flex items-center gap-3">
        <button onClick={() => navigate(-1)} className="text-muted text-2xl leading-none">←</button>
        <div>
          <h1 className="font-display text-xl font-bold text-ink">{item.name}</h1>
          <p className="text-xs text-muted">{item.category} · window {item.windowStart}–{item.windowEnd}</p>
        </div>
      </header>

      <div className="flex flex-col gap-2">
        {(records || []).map(r => (
          <div key={r.id} className="bg-surface rounded-card px-4 py-3 flex items-center justify-between">
            <span className="text-sm text-ink">{r.date}</span>
            <span className={`text-sm font-medium ${statusColor[r.status]}`}>{statusLabel[r.status]}</span>
          </div>
        ))}
        {(records || []).length === 0 && (
          <div className="text-center text-muted text-sm py-12">No history yet.</div>
        )}
      </div>

      <button
        onClick={handleDelete}
        className="mt-8 w-full py-3 rounded-card border border-absent/40 text-absent text-sm font-medium"
      >
        Delete this tracker
      </button>
    </div>
  )
}
