import { useNavigate } from 'react-router-dom'
import { STATUS } from '../lib/db.js'

const statusStyles = {
  [STATUS.ON_TIME]: { dot: 'bg-present', label: 'Checked in' },
  [STATUS.LATE]: { dot: 'bg-late', label: 'Checked in (late)' },
  [STATUS.ABSENT]: { dot: 'bg-absent', label: 'Missed' },
  [STATUS.PENDING]: { dot: 'bg-muted', label: 'Not checked in' }
}

export default function ItemCard({ item, record, onCheckIn, onCheckOut }) {
  const navigate = useNavigate()
  const status = record?.status || STATUS.PENDING
  const style = statusStyles[status]
  const canCheckOut = record?.checkInAt && !record?.checkOutAt

  return (
    <div className="bg-surface rounded-card p-4 flex items-center justify-between">
      <button
        className="flex items-center gap-3 flex-1 text-left"
        onClick={() => navigate(`/item/${item.id}`)}
      >
        <span className={`w-2.5 h-2.5 rounded-full ${style.dot} shrink-0`} />
        <div>
          <div className="font-display font-semibold text-ink">{item.name}</div>
          <div className="text-xs text-muted">{style.label} · {item.category}</div>
        </div>
      </button>

      <div className="flex gap-2 shrink-0">
        {!record?.checkInAt && (
          <button
            onClick={() => onCheckIn(item)}
            className="px-4 py-2 rounded-full bg-present text-base font-semibold text-sm active:scale-95 transition"
          >
            Check in
          </button>
        )}
        {canCheckOut && (
          <button
            onClick={() => onCheckOut(item)}
            className="px-4 py-2 rounded-full bg-surface2 border border-line text-ink font-semibold text-sm active:scale-95 transition"
          >
            Check out
          </button>
        )}
        {record?.checkOutAt && (
          <span className="px-3 py-2 text-xs text-muted">Done for today</span>
        )}
      </div>
    </div>
  )
}
