import { useState } from 'react'
import { useNavigate } from 'react-router-dom'
import { db, CATEGORY, METHODS } from '../lib/db.js'

const WEEKDAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']

export default function AddAttendance() {
  const navigate = useNavigate()
  const [step, setStep] = useState(1)
  const [name, setName] = useState('')
  const [category, setCategory] = useState(CATEGORY.CLASS)
  const [methods, setMethods] = useState(['manual'])
  const [windowStart, setWindowStart] = useState('09:00')
  const [windowEnd, setWindowEnd] = useState('09:15')
  const [weekdays, setWeekdays] = useState([1, 2, 3, 4, 5])
  const [reminderOn, setReminderOn] = useState(true)

  function toggleMethod(id) {
    setMethods(m => m.includes(id) ? m.filter(x => x !== id) : [...m, id])
  }

  function toggleWeekday(i) {
    setWeekdays(w => w.includes(i) ? w.filter(x => x !== i) : [...w, i].sort())
  }

  async function handleSave() {
    const itemId = await db.items.add({
      name: name.trim() || 'Untitled',
      category,
      methods,
      windowStart,
      windowEnd,
      createdAt: new Date().toISOString()
    })
    if (reminderOn) {
      await db.reminders.bulkAdd(
        weekdays.map(weekday => ({ itemId, weekday, windowStart, windowEnd, snoozedUntil: null }))
      )
    }
    navigate('/')
  }

  return (
    <div className="max-w-md mx-auto px-4 pb-24">
      <header className="pt-8 pb-4 flex items-center gap-3">
        <button onClick={() => (step === 1 ? navigate('/') : setStep(step - 1))} className="text-muted text-2xl leading-none">←</button>
        <h1 className="font-display text-xl font-bold text-ink">Add attendance</h1>
      </header>

      <div className="flex gap-1.5 mb-8">
        {[1, 2, 3].map(s => (
          <div key={s} className={`h-1 flex-1 rounded-full ${s <= step ? 'bg-present' : 'bg-line'}`} />
        ))}
      </div>

      {step === 1 && (
        <div className="flex flex-col gap-5">
          <div>
            <label className="text-sm text-muted mb-2 block">What are you tracking?</label>
            <input
              autoFocus
              value={name}
              onChange={e => setName(e.target.value)}
              placeholder="e.g. Data Structures, Office, Morning gym"
              className="w-full bg-surface rounded-card px-4 py-3 text-ink placeholder:text-muted outline-none focus:ring-2 focus:ring-present"
            />
          </div>
          <div>
            <label className="text-sm text-muted mb-2 block">Category</label>
            <div className="flex flex-col gap-2">
              {Object.values(CATEGORY).map(c => (
                <button
                  key={c}
                  onClick={() => setCategory(c)}
                  className={`text-left px-4 py-3 rounded-card border ${category === c ? 'border-present bg-surface2' : 'border-line bg-surface'}`}
                >
                  {c}
                </button>
              ))}
            </div>
          </div>
          <button
            disabled={!name.trim()}
            onClick={() => setStep(2)}
            className="mt-4 w-full py-4 rounded-card bg-present text-base font-display font-semibold disabled:opacity-40"
          >
            Continue
          </button>
        </div>
      )}

      {step === 2 && (
        <div className="flex flex-col gap-5">
          <div>
            <label className="text-sm text-muted mb-2 block">How is attendance recorded?</label>
            <div className="flex flex-col gap-2">
              {METHODS.map(m => (
                <button
                  key={m.id}
                  onClick={() => toggleMethod(m.id)}
                  className={`text-left px-4 py-3 rounded-card border flex items-center justify-between ${methods.includes(m.id) ? 'border-present bg-surface2' : 'border-line bg-surface'}`}
                >
                  <span>{m.label}</span>
                  {methods.includes(m.id) && <span className="text-present">✓</span>}
                </button>
              ))}
            </div>
            {methods.includes('biometric_signature') && (
              <p className="text-xs text-muted mt-2">
                Hybrid mode: the app will track your on-time window below; the biometric device and
                paper signature remain your official record — this just mirrors the deadline so you don't miss it.
              </p>
            )}
          </div>

          <div>
            <label className="text-sm text-muted mb-2 block">Check-in window</label>
            <div className="flex gap-3">
              <input type="time" value={windowStart} onChange={e => setWindowStart(e.target.value)}
                className="flex-1 bg-surface rounded-card px-4 py-3 text-ink outline-none focus:ring-2 focus:ring-present" />
              <span className="text-muted self-center">to</span>
              <input type="time" value={windowEnd} onChange={e => setWindowEnd(e.target.value)}
                className="flex-1 bg-surface rounded-card px-4 py-3 text-ink outline-none focus:ring-2 focus:ring-present" />
            </div>
            <p className="text-xs text-muted mt-2">Checking in after this window will be marked late; not checking in at all is marked absent.</p>
          </div>

          <button onClick={() => setStep(3)} className="mt-4 w-full py-4 rounded-card bg-present text-base font-display font-semibold">
            Continue
          </button>
        </div>
      )}

      {step === 3 && (
        <div className="flex flex-col gap-5">
          <div className="flex items-center justify-between bg-surface rounded-card px-4 py-3">
            <span className="text-ink font-medium">Remind me</span>
            <button
              onClick={() => setReminderOn(r => !r)}
              className={`w-12 h-7 rounded-full transition relative ${reminderOn ? 'bg-present' : 'bg-line'}`}
            >
              <span className={`absolute top-1 w-5 h-5 rounded-full bg-base transition-all ${reminderOn ? 'left-6' : 'left-1'}`} />
            </button>
          </div>

          {reminderOn && (
            <>
              <div>
                <label className="text-sm text-muted mb-2 block">Which days?</label>
                <div className="flex gap-2">
                  {WEEKDAYS.map((d, i) => (
                    <button
                      key={d}
                      onClick={() => toggleWeekday(i)}
                      className={`w-10 h-10 rounded-full text-xs font-semibold ${weekdays.includes(i) ? 'bg-present text-base' : 'bg-surface text-muted'}`}
                    >
                      {d}
                    </button>
                  ))}
                </div>
              </div>
              <div className="bg-surface rounded-card p-4 text-sm text-muted">
                If you haven't checked in as the window is closing, you'll get a short ping,
                a vibration, and a reminder on screen. It stays up until you submit attendance,
                snooze 10 minutes, or ignore for today.
              </div>
            </>
          )}

          <button onClick={handleSave} className="mt-4 w-full py-4 rounded-card bg-present text-base font-display font-semibold">
            Save
          </button>
        </div>
      )}
    </div>
  )
}
