import { useNavigate } from 'react-router-dom'
import { useLiveQuery } from 'dexie-react-hooks'
import { db, STATUS } from '../lib/db.js'

export default function Stats() {
  const navigate = useNavigate()
  const items = useLiveQuery(() => db.items.toArray(), [])
  const records = useLiveQuery(() => db.records.toArray(), [])

  function statsFor(itemId) {
    const rs = (records || []).filter(r => r.itemId === itemId)
    const total = rs.length
    const present = rs.filter(r => r.status === STATUS.ON_TIME || r.status === STATUS.LATE).length
    const pct = total === 0 ? 0 : Math.round((present / total) * 100)
    return { total, present, pct }
  }

  return (
    <div className="max-w-md mx-auto px-4 pb-24">
      <header className="pt-8 pb-6 flex items-center gap-3">
        <button onClick={() => navigate('/')} className="text-muted text-2xl leading-none">←</button>
        <h1 className="font-display text-xl font-bold text-ink">Stats</h1>
      </header>

      <div className="flex flex-col gap-4">
        {(items || []).map(item => {
          const s = statsFor(item.id)
          return (
            <button
              key={item.id}
              onClick={() => navigate(`/item/${item.id}`)}
              className="bg-surface rounded-card p-4 text-left"
            >
              <div className="flex items-center justify-between mb-2">
                <span className="font-display font-semibold text-ink">{item.name}</span>
                <span className="font-display text-lg font-bold text-present">{s.pct}%</span>
              </div>
              <div className="w-full h-2 bg-surface2 rounded-full overflow-hidden">
                <div className="h-full bg-present" style={{ width: `${s.pct}%` }} />
              </div>
              <div className="text-xs text-muted mt-2">{s.present} of {s.total} days present</div>
            </button>
          )
        })}
        {(items || []).length === 0 && (
          <div className="text-center text-muted text-sm py-12">No data yet — add something to track.</div>
        )}
      </div>
    </div>
  )
}
